services:
  crawler:
    build: .
    environment:
      - POSTGRES_HOST=${POSTGRES_HOST:-host.docker.internal}
      - POSTGRES_PORT=${POSTGRES_PORT:-5432}
      - POSTGRES_DB=${POSTGRES_DB:-postgres}
      - POSTGRES_USER=${POSTGRES_USER:-postgres}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-postgres}
      - MINIO_ENDPOINT=${MINIO_ENDPOINT:-}
      - MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-}
      - MINIO_SECRET_KEY=${MINIO_SECRET_KEY:-}
      - MINIO_BUCKET=${MINIO_BUCKET:-drug-predicate-documents}
      - TEST_MODE=${TEST_MODE:-false}
      - MAX_RECORDS_PER_COUNTRY=${MAX_RECORDS_PER_COUNTRY:-0}
    volumes:
      # Caches the FDA bulk-data zip so repeated runs don't re-download it
      # (which trips www.fda.gov's abuse detection). See the README.
      - ./.cache:/app/.cache
