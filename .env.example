# PostgreSQL (required) — same database/schema as source-information if you
# want drug_predicate_raw_records.country_id to line up with an existing
# source.country table.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MinIO (S3-compatible) — reuse the instance already running for
# source-information. Don't stand up a second MinIO for this repo.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=drug-predicate-documents

# Test mode: only crawl the countries listed in TEST_COUNTRIES
TEST_MODE=true
TEST_COUNTRIES=United Kingdom

# Countries to skip when TEST_MODE=false (comma-separated country names)
# SKIP_COUNTRIES=

# Crawl behavior
# MAX_RECORDS_PER_COUNTRY=0            # 0 = no limit
# MAX_SKIPPED_RECORDS_PER_COUNTRY=0  # 0 = disable early-stop (default)
# MAX_WORKERS=2
# DOWNLOAD_DOCUMENTS=true              # false = ingest metadata only, skip S3 upload

# MHRA / United Kingdom crawler (optional overrides; defaults in code)
# MHRA_LETTERS=A                        # limit substance-index letters crawled, for quick testing
# MHRA_SEARCH_ENDPOINT=https://mhraproducts4853.search.windows.net/indexes/products-index/docs
# MHRA_SEARCH_API_KEY=
# MHRA_BROWSER_WORKERS=4                # concurrent headless Chromium instances for product pages

# SAHPRA / South Africa crawler (optional overrides; defaults in code)
# SAHPRA_BASE_URL=https://medapps.sahpra.org.za:6006
# SAHPRA_PAGE_SIZE=100
# SAHPRA_DETAIL_WORKERS=6

# TGA / Australia crawler (optional override; default in code)
# TGA_DETAIL_WORKERS=10                 # concurrent PDF fetch+upload workers

# ANVISA / Brazil crawler (optional overrides; defaults in code)
# ANVISA_PAGE_SIZE=200                  # products per listing page
# ANVISA_REQUEST_DELAY_SECONDS=1.2      # deliberately conservative — see crawler_br_1.py
#                                        # module docstring on the confirmed Cloudflare
#                                        # rate-limit rule (429 + Retry-After: 600) this
#                                        # API enforces above ~25-30 requests in a burst

# Drugs@FDA / United States crawler (optional overrides; defaults in code).
# Does NOT scrape accessdata.fda.gov (Akamai-blocked from datacenter IPs) —
# see crawler_us_1.py module docstring for the full source-fallback chain.
# FDA_SOURCES=openfda_api,openfda_zip,fda_tsv  # source order; e.g. openfda_zip,fda_tsv to skip the query API
# FDA_API_URL=https://api.fda.gov/drug/drugsfda.json
# FDA_API_KEY=                          # free key from open.fda.gov raises the daily quota 1,000 -> 120,000 (240/min either way)
# FDA_API_DELAY_SECONDS=0.2             # pacing between openFDA API requests
# FDA_LABEL_API_URL=https://api.fda.gov/drug/label.json   # actual SPL label TEXT, looked up per application_number
# FDA_LABEL_FETCH_LIMIT=100             # max labels fetched per application (a shared label across 2+ applications is normal, not truncation)
# FDA_WORKERS=8                         # concurrent threads processing applications (label lookup + doc download)
# FDA_OPENFDA_ZIP_URL=https://download.open.fda.gov/drug/drugsfda/drug-drugsfda-0001-of-0001.json.zip
# FDA_BULK_ZIP_URL=https://www.fda.gov/media/89850/download   # FDA's raw TSV "Drugs@FDA Data Files"
# FDA_BULK_ATTEMPTS=5                   # retries for www.fda.gov's own Akamai abuse-detection cooldown
# FDA_BULK_BACKOFF_SECONDS=60
# FDA_BULK_CACHE_DIR=.cache/fda         # parsed-applications cache (source-agnostic); mount a volume here to persist across recreations
# FDA_BULK_CACHE_TTL_SECONDS=86400

# FDA spl_labels backfill (one-off maintenance, NOT part of the normal crawl —
# see app/crawlers/united_states/backfill_labels.py). Set FDA_BACKFILL_LABELS=true
# to make `python -m app.main` run ONLY this backfill instead of the normal
# per-country crawl loop: it recomputes json_data.spl_labels on every already-
# ingested US row (via the same batched openFDA lookup the crawler itself
# uses) without re-crawling drugsfda.json/the TSV or re-downloading any PDF.
# Unset it again afterwards. Preview what would change first with
# FDA_BACKFILL_DRY_RUN=true (logs counts, writes nothing).
# FDA_BACKFILL_LABELS=false
# FDA_BACKFILL_DRY_RUN=false

# Chrome/Chromium (optional; for future crawlers needing Selenium)
# CHROME_BIN=
# CHROMEDRIVER_PATH=
